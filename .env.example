# OpenStudyHub

NODE_ENV=development
APP_NAME=OpenStudyHub
APP_URL=http://localhost:3000

# Dados locais. No Compose, os caminhos são /app/data/... no volume persistente.
DATABASE_PATH=./data/openstudyhub.db
PRIVATE_ASSET_PATH=./data/private-assets

# V2 exige um segundo banco SQLite em caminho absoluto, diferente de DATABASE_PATH.
# Para Node local, ajuste o caminho absoluto antes de iniciar o App.
OPENSTUDYHUB_V2_ENABLED=1
OPENSTUDYHUB_V2_DATABASE_PATH=/app/data/v2.db

# Produção: publique somente o App; mantenha Admin local/LAN.
# Ajuste URL pública de WebSocket para o mesmo domínio do App.
OPENSTUDYHUB_REALTIME_PUBLIC_URL=ws://localhost:3000/realtime
# OPENSTUDYHUB_APP_BIND=127.0.0.1
# OPENSTUDYHUB_ADMIN_BIND=127.0.0.1

# Optional Google Study Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v2/google/callback
# Em produção, APP_URL e GOOGLE_REDIRECT_URI devem usar o domínio HTTPS real.
# Base64-encoded 32-byte key. Generate locally; never commit the real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional Google Picker configuration for selecting existing Google Docs.
# Restrinja a API key no Google Cloud antes do uso real.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# Optional instance-owned Google Docs converted from the distributed DOCX pack.
# Keep real file IDs only in the private instance environment.
GOOGLE_TEMPLATE_GENERIC_ACTIVITY_ID=
GOOGLE_TEMPLATE_PROGRAMMING_ACTIVITY_ID=
GOOGLE_TEMPLATE_CLASS_NOTES_ID=
CLASSROOM_SYNC_TTL_MINUTES=15
