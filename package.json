{
  "name": "openstudyhub",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "realtime:dev": "tsx scripts/realtime-server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset:development": "tsx scripts/reset-development-instance.ts"
  },
  "dependencies": {
    "@blocknote/ariakit": "0.56.0",
    "@blocknote/core": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@blocknote/server-util": "0.56.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@next/env": "16.4.3",
    "@tabler/icons-react": "^3.48.0",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "figlet": "1.11.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.6",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "yjs": "13.6.33",
    "zod": "4.6.7",
    "qrcode": "1.5.4",
    "mammoth": "1.11.0",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@types/qrcode": "1.5.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "dompurify": "3.4.17",
      "nanoid@^3": "3.3.18",
      "nanoid@^5": "5.1.16",
      "lodash-es": "4.18.1",
      "katex": "0.18.2",
      "source-map-js": "1.2.2",
      "vite": "8.3.5",
      "@esbuild-kit/core-utils>esbuild": "0.28.2",
      "nanoid@>=4 <6": "5.1.16"
    }
  },
  "license": "AGPL-3.0-only"
}
