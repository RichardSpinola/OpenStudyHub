{
  "manifest_version": 3,
  "name": "OpenStudyHub — Nova Aba",
  "version": "1.0.0",
  "description": "Abre sua instância OpenStudyHub em cada nova aba.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@openstudyhub-ucsal.dev",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "32": "icons/icon-32.png", "96": "icons/icon-96.png" }
}
